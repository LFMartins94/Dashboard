# Database
# Conexao direta (porta 5432) - preferencial
# Ex: postgresql://postgres:senha@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Django
# Gere uma chave longa e aleatoria para cada ambiente.
DJANGO_SECRET_KEY=substitua-por-uma-chave-longa-e-aleatoria
DJANGO_SETTINGS_MODULE=configuracao.settings.desenvolvimento
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_DATABASE_CONN_MAX_AGE=60
DJANGO_SECURE_SSL_REDIRECT=false

APP_USUARIO=nome_da_contadora
APP_SENHA=senha_de_acesso
OPENAI_API_KEY=sk-proj-...
